---
import Icon from './Icon.astro'

interface Props {
  currentPage: number
  totalPages: number
  baseUrl?: string
}

const { currentPage, totalPages, baseUrl = '/blog' } = Astro.props

const isFirstPage = currentPage === 1
const isLastPage = currentPage === totalPages

// Previous page URL
const prevPage = currentPage > 2 ? `${baseUrl}/page/${currentPage - 1}` : baseUrl

// Next page URL
const nextPage = currentPage + 1

// Generate page numbers array
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1)
---

<nav class="pagination-wrapper" aria-label="Page navigation">
  <ul class="pagination">
    <!-- First Page -->
    <li class={`page-item ${isFirstPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isFirstPage ? undefined : baseUrl} aria-label="First page">
        <Icon name="step-backward" size="0.875em" />
      </a>
    </li>

    <!-- Previous Page -->
    <li class={`page-item ${isFirstPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isFirstPage ? undefined : prevPage} aria-label="Previous page">
        <Icon name="chevron-left" size="0.875em" />
      </a>
    </li>

    <!-- Page Numbers -->
    {
      pageNumbers.map(pageNumber => {
        const isActive = pageNumber === currentPage
        const pageUrl = pageNumber === 1 ? baseUrl : `${baseUrl}/page/${pageNumber}`

        return (
          <li class={`page-item ${isActive ? 'active' : ''}`}>
            {isActive ? (
              <span class="page-link">{pageNumber}</span>
            ) : (
              <a class="page-link" href={pageUrl}>
                {pageNumber}
              </a>
            )}
          </li>
        )
      })
    }

    <!-- Next Page -->
    <li class={`page-item ${isLastPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isLastPage ? undefined : `${baseUrl}/page/${nextPage}`} aria-label="Next page">
        <Icon name="chevron-right" size="0.875em" />
      </a>
    </li>

    <!-- Last Page -->
    <li class={`page-item ${isLastPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isLastPage ? undefined : `${baseUrl}/page/${totalPages}`} aria-label="Last page">
        <Icon name="step-forward" size="0.875em" />
      </a>
    </li>
  </ul>
</nav>
