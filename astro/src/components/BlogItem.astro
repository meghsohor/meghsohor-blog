---
const { post } = Astro.props

// Format date helper
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: '2-digit',
  })
}
---

<div class='card blog-card'>
  <a href={`/blog/${post.slug}`}>
    <img src={post.image} alt={post.title} class='rounded mb-4' />
  </a>
  <div class='card-body'>
    <h5 class='card-title'>
      <a href={`/blog/${post.slug}`}>{post.title}</a>
    </h5>
    <div class='text-muted card-subtitle'>{formatDate(post.date)}</div>

    <p class='mb-2'>{post.description}</p>

    <div class='tags'>
      {post.tags.map((tag: string) => <span class='tag'>{tag}</span>)}
    </div>
    <a href={`/blog/${post.slug}`} class='btn btn-outline-primary ml-auto'>Read Post</a>
  </div>
</div>
