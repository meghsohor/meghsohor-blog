---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../components/BaseLayout.astro'
import JsonLd from '../../components/JsonLd.astro'
import CopyMarkdownButton from '../../components/CopyMarkdownButton.astro'
import { site } from '../../config'
import { slugify, formatDate } from '../../utils'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await post.render()

const postURL = new URL(`/blog/${post.slug}/`, site.siteURL).toString()
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, site.siteURL).toString(),
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: post.data.author, '@id': `${site.siteURL}/#person` },
  url: postURL,
  mainEntityOfPage: postURL,
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  showSidebar={true}
  meta={[
    { property: 'og:type', content: 'article' },
    { property: 'article:published_time', content: post.data.date.toISOString() },
    { property: 'article:author', content: post.data.author },
  ]}
>
  <JsonLd slot="head" schema={postSchema} />
  <link slot="head" rel="alternate" type="text/markdown" href={`/blog/${post.slug}.md`} title="Plain markdown version" />
  <article class="single-post-card card p-6 md:p-8" data-pagefind-body>
    <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>

    <div class="single-post-date-and-tags mb-6">
      <div class="card-subtitle text-muted flex items-center justify-between flex-wrap gap-x-4 gap-y-2">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <CopyMarkdownButton markdown={post.body} fallbackHref={`/blog/${post.slug}.md`} />
      </div>
      <ul class="post-tags mt-4">
        {
          post.data.tags.map(tag => (
            <li>
              <a href={`/tags/${slugify(tag)}`} class="tag">
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {post.data.image && <img src={post.data.image} alt={post.data.title} class="w-full rounded-lg mb-8" />}

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
