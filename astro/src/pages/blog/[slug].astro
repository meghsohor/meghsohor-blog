---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../components/BaseLayout.astro'
import { slugify, formatDate } from '../../utils'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await post.render()
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image} showSidebar={true}>
  <article class="single-post-card card p-6 md:p-8" data-pagefind-body>
    <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>

    <div class="single-post-date-and-tags mb-6">
      <div class="card-subtitle text-muted">
        {formatDate(post.data.date)} • By {post.data.author}
      </div>
      <ul class="post-tags">
        {
          post.data.tags.map(tag => (
            <li>
              <a href={`/tags/${slugify(tag)}`} class="tag">
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {post.data.image && <img src={post.data.image} alt={post.data.title} class="w-full rounded-lg mb-8" />}

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
