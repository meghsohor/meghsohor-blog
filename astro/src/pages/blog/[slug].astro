---
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../components/BaseLayout.astro'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await post.render()

// Format date helper
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: '2-digit',
  })
}
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image} showSidebar={true}>
  <article class='single-post-card card'>
    <h1 class='text-4xl font-bold mb-4'>{post.data.title}</h1>

    <div class='single-post-date-and-tags mb-6'>
      <div class='card-subtitle text-muted'>
        {formatDate(post.data.date)} • By {post.data.author}
      </div>
      <ul class='post-tags'>
        {
          post.data.tags.map(tag => (
            <li>
              <a href={`/tags/${tag.toLowerCase()}`} class='tag'>
                {tag}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {post.data.image && <img src={post.data.image} alt={post.data.title} class='w-full rounded-lg mb-8' />}

    <div class='prose prose-lg max-w-none'>
      <Content />
    </div>
  </article>
</BaseLayout>
