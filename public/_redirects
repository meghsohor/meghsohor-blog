# Targets end in / to match the built URLs — otherwise each 301 lands on another 301.

# Old Gatsby tag URLs → new /tags structure.
# Exception: no slash after :splat — the indexed URLs are /tag/<tag>/, so it already has one.
/tag/*  /tags/:splat  301

# /about was a real page on the Gatsby site; the About section now lives on the homepage.
# /team predates that and pointed at /about for years.
/about  /  301
/team  /  301

