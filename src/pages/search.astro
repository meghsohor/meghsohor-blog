---
import BaseLayout from '../components/BaseLayout.astro'
---

<BaseLayout title="Search Posts">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script slot="head" is:inline src="/pagefind/pagefind-ui.js"></script>

  <section class="container py-12">
    <h1 class="section-heading"><span>Search</span></h1>
    <div id="search" class="max-w-2xl mx-auto"></div>
  </section>

  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false })
      } else {
        document.getElementById('search').innerHTML = '<p>Search is only available on the deployed site (the index is generated at build time).</p>'
      }
    })
  </script>
</BaseLayout>

<style>
  #search {
    --pagefind-ui-primary: var(--theme-primary);
    --pagefind-ui-text: var(--theme-body);
    --pagefind-ui-background: var(--theme-surface);
    --pagefind-ui-border: var(--theme-border-soft);
    --pagefind-ui-font: var(--font-serif);
  }
</style>
