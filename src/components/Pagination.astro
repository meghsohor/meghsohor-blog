---
import Icon from './Icon.astro'

interface Props {
  currentPage: number
  totalPages: number
  baseUrl?: string
}

const { currentPage, totalPages, baseUrl = '/blog' } = Astro.props

const isFirstPage = currentPage === 1
const isLastPage = currentPage === totalPages

// Trailing slash matches the built URLs, so links never hit a Netlify redirect
const pageHref = (page: number) => (page === 1 ? `${baseUrl}/` : `${baseUrl}/page/${page}/`)

// Generate page numbers array
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1)
---

<nav class="pagination-wrapper" aria-label="Page navigation">
  <ul class="pagination">
    <!-- First Page -->
    <li class={`page-item ${isFirstPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isFirstPage ? undefined : pageHref(1)} aria-label="First page">
        <Icon name="step-backward" size="0.875em" />
      </a>
    </li>

    <!-- Previous Page -->
    <li class={`page-item ${isFirstPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isFirstPage ? undefined : pageHref(currentPage - 1)} aria-label="Previous page">
        <Icon name="chevron-left" size="0.875em" />
      </a>
    </li>

    <!-- Page Numbers -->
    {
      pageNumbers.map(pageNumber => {
        const isActive = pageNumber === currentPage
        const pageUrl = pageHref(pageNumber)

        return (
          <li class={`page-item ${isActive ? 'active' : ''}`}>
            {isActive ? (
              <span class="page-link">{pageNumber}</span>
            ) : (
              <a class="page-link" href={pageUrl}>
                {pageNumber}
              </a>
            )}
          </li>
        )
      })
    }

    <!-- Next Page -->
    <li class={`page-item ${isLastPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isLastPage ? undefined : pageHref(currentPage + 1)} aria-label="Next page">
        <Icon name="chevron-right" size="0.875em" />
      </a>
    </li>

    <!-- Last Page -->
    <li class={`page-item ${isLastPage ? 'disabled' : ''}`}>
      <a class="page-link" href={isLastPage ? undefined : pageHref(totalPages)} aria-label="Last page">
        <Icon name="step-forward" size="0.875em" />
      </a>
    </li>
  </ul>
</nav>
