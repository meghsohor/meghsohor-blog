---
import { getCollection } from 'astro:content'
import { publicImageDims } from '../image-dims'
import { cdnImage, CARD_WIDTHS, CARD_SIZES } from '../image-cdn.mjs'

const portfolioItems = await getCollection('portfolio')
const sortedPortfolio = portfolioItems.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<section class="portfolio-section bg-page py-16 md:py-24">
  <div class="container">
    <h2 class="section-heading">
      <span>Portfolio</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        sortedPortfolio.map(async project => {
          const { Content } = await project.render()
          const dims = await publicImageDims(project.data.image)
          const img = cdnImage(project.data.image, dims?.width, CARD_WIDTHS)
          return (
            <article class="portfolio-card card">
              <img
                src={img.src}
                srcset={img.srcset}
                sizes={img.srcset ? CARD_SIZES : undefined}
                alt={project.data.title}
                class="w-full"
                width={dims?.width}
                height={dims?.height}
                loading="lazy"
                decoding="async"
              />
              <div class="card-body">
                <h3 class="card-title">{project.data.title}</h3>
                <div class="mb-4">
                  <Content />
                </div>
                <div class="tags">
                  {project.data.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary ml-auto">
                  View Live
                </a>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
