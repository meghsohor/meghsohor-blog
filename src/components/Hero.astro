---
import Icon from './Icon.astro'
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-header">
      <h1>Shafiqul Islam</h1>
      <p class="hero-subtitle">Software Developer</p>
    </div>
    <div class="learn-more">
      <a href="#about" id="learn-more-link" class="learn-more-btn" aria-label="Learn more, scroll to About section">
        <span class="learn-more-icon"><Icon name="chevron-down" size="1.1em" /></span>
      </a>
    </div>
  </div>
</section>

<script>
  const handleLearnMoreClick = (e: Event) => {
    e.preventDefault()
    const aboutSection = document.getElementById('about')
    const header = document.querySelector('.site-header')

    if (aboutSection && header) {
      const headerHeight = header.getBoundingClientRect().height
      const positionY = aboutSection.offsetTop - headerHeight

      window.scroll({
        top: positionY,
        behavior: 'smooth',
      })
    }
  }

  const link = document.getElementById('learn-more-link')
  if (link) {
    // Remove any existing listener before adding a new one
    link.removeEventListener('click', handleLearnMoreClick)
    link.addEventListener('click', handleLearnMoreClick)
  }
</script>
