---
import Icon from './Icon.astro'
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-header">
      <h1>
        <span>
          Shafiqul Islam
          <span class="sub-span"><span>Software Developer</span></span>
        </span>
      </h1>
    </div>
    <div class="learn-more">
      <a href="#about" id="learn-more-link" aria-label="Learn more, scroll to About section">
        <div class="text">Learn More</div>
        <div class="icon"><Icon name="chevron-down" size="18px" /></div>
      </a>
    </div>
  </div>
</section>

<script>
  const link = document.getElementById('learn-more-link')
  link?.addEventListener('click', e => {
    e.preventDefault()
    const aboutSection = document.getElementById('about')
    const header = document.querySelector('.site-header')
    if (aboutSection && header) {
      window.scroll({
        top: aboutSection.offsetTop - header.getBoundingClientRect().height,
        behavior: 'smooth',
      })
    }
  })
</script>
