---
import Icon from './Icon.astro'
import { publicImageDims } from '../image-dims'
import { cdnImage } from '../image-cdn.mjs'

const HERO_BG = '/images/hero-banner.jpeg'
const bgDims = await publicImageDims(HERO_BG)
const heroBg = cdnImage(HERO_BG, bgDims?.width, [768, 1080, 1440, 1920])
---

<section class="hero-section">
  <img
    src={heroBg.src}
    srcset={heroBg.srcset}
    sizes={heroBg.srcset ? '100vw' : undefined}
    alt=""
    class="hero-bg"
    width={bgDims?.width}
    height={bgDims?.height}
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-container">
    <div class="hero-header">
      <h1>
        <span>
          Shafiqul Islam
          <span class="sub-span"><span>Software Developer</span></span>
        </span>
      </h1>
    </div>
    <div class="learn-more">
      <a href="#about" id="learn-more-link" aria-label="Learn more, scroll to About section">
        <div class="text">Learn More</div>
        <div class="icon"><Icon name="chevron-down" size="18px" /></div>
      </a>
    </div>
  </div>
</section>

<script>
  const link = document.getElementById('learn-more-link')
  link?.addEventListener('click', e => {
    e.preventDefault()
    const aboutSection = document.getElementById('about')
    const header = document.querySelector('.site-header')
    if (aboutSection && header) {
      window.scroll({
        top: aboutSection.offsetTop - header.getBoundingClientRect().height,
        behavior: 'smooth',
      })
    }
  })
</script>
