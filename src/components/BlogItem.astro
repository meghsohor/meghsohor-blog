---
import { slugify, formatDate } from '../utils'
import { publicImageDims } from '../image-dims'
import { cdnImage, CARD_WIDTHS, CARD_SIZES } from '../image-cdn.mjs'

const { post } = Astro.props
const dims = await publicImageDims(post.image)
const img = cdnImage(post.image, dims?.width, CARD_WIDTHS)
---

<article class="card blog-card">
  <a href={`/blog/${post.slug}/`} class="thumb-link">
    <img
      src={img.src}
      srcset={img.srcset}
      sizes={img.srcset ? CARD_SIZES : undefined}
      alt={post.title}
      class="mb-4"
      width={dims?.width}
      height={dims?.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="card-body">
    <h5 class="card-title">
      <a href={`/blog/${post.slug}/`}>{post.title}</a>
    </h5>
    <div class="text-muted card-subtitle">
      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
    </div>

    <p class="mb-2">{post.description}</p>

    <div class="tags">
      {
        post.tags.map((tag: string) => (
          <a href={`/tags/${slugify(tag)}/`} class="tag">
            {tag}
          </a>
        ))
      }
    </div>
    <a href={`/blog/${post.slug}/`} class="btn btn-outline-primary ml-auto">Read Post</a>
  </div>
</article>
