---
import { getCollection } from 'astro:content'
import { tagCounts } from '../utils'
import { publicImageDims } from '../image-dims'

const posts = (await getCollection('blog')).sort((a, b) => b.data.postNumber - a.data.postNumber)
const recentPosts = await Promise.all(posts.slice(0, 3).map(async post => ({ post, dims: await publicImageDims(post.data.image) })))
const tags = tagCounts(posts)
---

<div class="card mb-6">
  <div class="card-body">
    <h5 class="card-title text-center uppercase font-bold">Recent Posts</h5>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-4">
      {
        recentPosts.map(({ post, dims }) => (
          <a href={`/blog/${post.slug}/`} class="recent-post card">
            <img src={post.data.image} alt={post.data.title} class="w-full" width={dims?.width} height={dims?.height} loading="lazy" decoding="async" />
            <div class="card-body">
              <h6 class="mb-0">{post.data.title}</h6>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h5 class="card-title text-center uppercase font-bold">Tags</h5>
    <div class="tags">
      {
        tags.map(([slug, { name, count }]) => (
          <a href={`/tags/${slug}/`} class="tag">
            {name} ({count})
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .recent-post {
    display: block;
    color: var(--theme-body);
  }
  .recent-post:hover h6 {
    color: var(--theme-primary);
  }
</style>
